#!/usr/bin/env bash

## Copyright (C) 2020-2024 Aditya Shakya <adi1090x@gmail.com>

# Import Current Theme
DIR="$HOME/.config/hypr"
RASI="$DIR/rofi/powermenu.rasi"
CNFR="$DIR/rofi/confirm.rasi"

# Theme Elements
prompt="$(hostname) ($DESKTOP_SESSION)"
mesg="Uptime : $(uptime -p | sed -e 's/up //g')"

# Options
if grep -q 'USE_ICON=NO' "$RASI"; then
	lock=" Lock"
	logout=" Logout"
	suspend=" Suspend"
	reboot=" Reboot"
	shutdown=" Shutdown"
else
	lock=""
	logout=""
	suspend=""
	reboot=""
	shutdown=""
fi
if grep -q 'USE_ICON=NO' "$CNFR"; then
	yes=' Yes'
	no=' No'
else
	yes=''
	no=''
fi

# Rofi CMD
rofi_cmd() {
	rofi -dmenu \
		-normal-window \
		-p "$prompt" \
		-mesg "$mesg" \
		-markup-rows \
		-theme "$RASI"
}

# Pass variables to rofi dmenu
run_rofi() {
	printf '%s\n' "$lock" "$logout" "$suspend" "$reboot" "$shutdown" | rofi_cmd
}

# Confirmation CMD
confirm_cmd() {
	rofi -dmenu \
		-normal-window \
		-p 'Confirmation' \
		-mesg 'Are you Sure?' \
		-theme "$CNFR"
}

# Ask for confirmation
confirm_exit() {
	printf '%s\n' "$yes" "$no" | confirm_cmd
}

# Confirm and execute
confirm_run() {
	if [[ "$(confirm_exit)" == "$yes" ]]; then
		"$@"
	fi
}

# Actions
chosen="$(run_rofi)"
case "$chosen" in
	"$lock")
		hyprlock
		;;
	"$logout")
		if [[ "$DESKTOP_SESSION" == openbox ]]; then
			openbox --exit
		elif [[ "$DESKTOP_SESSION" == bspwm ]]; then
			bspc quit
		elif [[ "$DESKTOP_SESSION" == i3* ]]; then
			i3-msg exit
		elif [[ "$DESKTOP_SESSION" == plasma ]]; then
			qdbus org.kde.ksmserver /KSMServer logout 0 0 0
		elif [[ "$DESKTOP_SESSION" == xfce* ]]; then
			killall xfce4-session
		elif [[ "$DESKTOP_SESSION" == hyprland* ]]; then
			command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'
		fi
		;;
	"$suspend")
		confirm_run systemctl suspend
		;;
	"$reboot")
		confirm_run systemctl reboot
		;;
	"$shutdown")
		confirm_run systemctl poweroff
		;;
esac
