{{ if (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.idLike "arch")) -}}
#!/usr/bin/env bash

cat <<EOF | xargs -ro yay -S --needed
{{ range .packages.archlinux.regular -}}
{{ . | quote }}
{{ end -}}
EOF

if lspci | grep VGA | grep -qi nvidia; then
cat <<EOF | xargs -ro yay -S --needed
{{ range .packages.archlinux.nvidia -}}
{{ . | quote }}
{{ end -}}
EOF
fi

{{ end -}}
