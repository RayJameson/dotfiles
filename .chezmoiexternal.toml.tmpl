[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = false
    stripComponents = 1
    refreshPeriod = "168h"
[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/master.tar.gz"
    exact = false
    stripComponents = 1
    refreshPeriod = "168h"
[".oh-my-zsh/custom/plugins/fzf-tab"]
    type = "archive"
    url = "https://github.com/Aloxaf/fzf-tab/archive/master.tar.gz"
    exact = false
    stripComponents = 1
    refreshPeriod = "168h"
[".oh-my-zsh/custom/plugins/zsh-vi-mode"]
    type = "archive"
    url = "https://github.com/jeffreytse/zsh-vi-mode/archive/master.tar.gz"
    exact = false
    stripComponents = 1
    refreshPeriod = "168h"
[".oh-my-zsh/custom/themes/powerlevel10k"]
    type = "archive"
    url = "https://github.com/romkatv/powerlevel10k/archive/v1.15.0.tar.gz"
    exact = false
    stripComponents = 1
[".config/tmux/plugins/tpm"]
    type = "archive"
    url = "https://github.com/tmux-plugins/tpm/archive/master.tar.gz"
    exact = false
    stripComponents = 1
    refreshPeriod = "168h"
[".local/bin/rdt"]
    type = "file"
    executable = true
    exact = false
    url = "https://raw.githubusercontent.com/RayJameson/rdt/refs/heads/master/rdt"
    refreshPeriod = "168h"
[".zfunc/_rdt"]
    type = "file"
    url = "https://raw.githubusercontent.com/RayJameson/rdt/refs/heads/master/completion/zsh/_rdt"
    exact = false
    refreshPeriod = "168h"
{{ if eq .chezmoi.os "darwin" -}}
{{ $yazi := "https://github.com/sxyazi/yazi/releases/download/nightly/yazi-aarch64-apple-darwin.zip" -}}
[".local/bin/yazi"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    path = "yazi-aarch64-apple-darwin/yazi"
    executable = true
    refreshPeriod = "168h"
[".local/bin/ya"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    path = "yazi-aarch64-apple-darwin/ya"
    executable = true
    refreshPeriod = "168h"
[".zfunc/_yazi"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    path = "yazi-aarch64-apple-darwin/completions/_yazi"
    refreshPeriod = "168h"
[".zfunc/_ya"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    path = "yazi-aarch64-apple-darwin/completions/_ya"
    refreshPeriod = "168h"
{{ end -}}
